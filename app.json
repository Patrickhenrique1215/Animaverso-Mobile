    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "extra": {
      "eas": {
        "projectId": "d90ef349-79db-491a-903e-acd988a39416"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
